# Non-production: ac-ws-dev-use2 (us-east-2). One file per cluster; no secrets in here.
#   make configure ENV=dev   ->  deploy/dev/   (commit it)
#   make preflight install verify ENV=dev

# --- Cluster ------------------------------------------------------------------------
KUBE_CONTEXT="arn:aws:eks:us-east-2:111122223333:cluster/ac-ws-dev-use2"
CLUSTER_NAME="ac-ws-dev-use2"
AWS_REGION="us-east-2"                      # cluster region AND Bedrock region
AWS_ACCOUNT_ID="111122223333"
ENVIRONMENT="nonprod"                       # prod turns on the production rules and guardrails

# --- Model (Amazon Bedrock) -------------------------------------------------------------
LLM_MODEL="us.anthropic.claude-sonnet-4-5-20250929-v1:0"   # verified with converse from us-east-2
AWS_AUTH_MODE="pod-identity"                # pod-identity | irsa
GATEWAY_IAM_ROLE_NAME="ac-ws-dev-use2-agentgateway-bedrock"
BEDROCK_PRIVATE_ENDPOINT="false"            # true: create/reuse a bedrock-runtime VPC endpoint

# --- What the agent may see and do ------------------------------------------------------
DEMO_APP="true"                             # repo creates DEMO_NAMESPACE and puts the sample apps in it
DEMO_NAMESPACE="sre-sandbox"
APP_NAMESPACES="sre-sandbox"                # read + restart/scale (with approval)
APP_NAMESPACES_READONLY="radar"             # read only, never remediated ("" to hide it)
MAX_REPLICAS="10"
# LLM budget per gateway replica. Over budget => 429 before the call reaches Bedrock.
# One triage of a few workloads is ~10-20 model calls of 10-30k tokens each.
# Keep within your Bedrock quota (Service Quotas: tokens per minute for the model).
LLM_TOKENS_PER_MINUTE="400000"
LLM_REQUESTS_PER_MINUTE="120"

# --- Network ------------------------------------------------------------------------
EGRESS_LOCKDOWN="true"                      # default-deny egress for every platform namespace
CENTRAL_OTLP_ENDPOINT=""                    # OTLP/HTTP backend; empty = collector logs only
CENTRAL_OTLP_CIDRS="0.0.0.0/0"              # where that backend lives, for the egress rule
DNS_EXTRA_CIDRS=""                          # e.g. "169.254.20.10/32" if you run NodeLocal DNSCache

# --- Delivery -----------------------------------------------------------------------
DEPLOY_MODE="direct"                        # direct (Helm + kubectl) | gitops; prod must be gitops
GIT_REPO_URL="https://github.com/ajaychinthapalli/eks-governed-sre-agent.git"
GIT_REVISION="main"
ARGOCD_NAMESPACE="argocd"
GATEWAY_API_CRDS="auto"                     # auto: keep the cluster's own if v1.5+

# --- Access -------------------------------------------------------------------------
KAGENT_OIDC="false"
KAGENT_EXTERNAL_DB="false"
