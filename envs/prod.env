# Production environment. `make configure ENV=prod` refuses to render unless:
#   DEPLOY_MODE=gitops, GIT_REVISION is a release tag or commit SHA, DEMO_APP=false,
#   EGRESS_LOCKDOWN=true, BEDROCK_PRIVATE_ENDPOINT=true.
# It also adds the prod guardrails: only Argo CD (or BREAKGLASS_GROUPS) may change the agent's RBAC.

# --- Cluster ------------------------------------------------------------------------
KUBE_CONTEXT="arn:aws:eks:us-east-1:111122223333:cluster/prod-1"
CLUSTER_NAME="prod-1"
AWS_REGION="us-east-1"
AWS_ACCOUNT_ID="111122223333"
ENVIRONMENT="prod"

# --- Model (Amazon Bedrock) -------------------------------------------------------------
LLM_MODEL="us.anthropic.claude-sonnet-4-5-20250929-v1:0"
AWS_AUTH_MODE="pod-identity"
GATEWAY_IAM_ROLE_NAME="prod-1-agentgateway-bedrock"
BEDROCK_PRIVATE_ENDPOINT="true"

# --- What the agent may see and do ------------------------------------------------------
APP_NAMESPACES="payments checkout"          # existing namespaces: RoleBindings only
APP_NAMESPACES_READONLY="ledger"            # visible, never remediated
DEMO_APP="false"
DEMO_NAMESPACE="shop-demo"
MAX_REPLICAS="10"
# LLM budget per gateway replica. Over budget => 429 before the call reaches Bedrock.
# One triage of a few workloads is ~10-20 model calls of 10-30k tokens each.
# Keep within your Bedrock quota (Service Quotas: tokens per minute for the model).
LLM_TOKENS_PER_MINUTE="400000"
LLM_REQUESTS_PER_MINUTE="120"

# --- Network ------------------------------------------------------------------------
EGRESS_LOCKDOWN="true"
CENTRAL_OTLP_ENDPOINT=""
CENTRAL_OTLP_CIDRS="0.0.0.0/0"
DNS_EXTRA_CIDRS=""

# --- Delivery -----------------------------------------------------------------------
DEPLOY_MODE="gitops"
GIT_REPO_URL="https://github.com/ajaychinthapalli/eks-governed-sre-agent.git"
GIT_REVISION="v2.0.0"                       # release tag; bump it to promote
ARGOCD_NAMESPACE="argocd"
GATEWAY_API_CRDS="auto"
SYNC_WINDOW_CRON=""                         # e.g. "0 14 * * 1-4": auto-sync only in that window
SYNC_WINDOW_DURATION="4h"

# --- Access -------------------------------------------------------------------------
# Kubernetes groups allowed to change the agent's RBAC outside Git (break-glass). Map an
# EKS access entry to one of these groups for your on-call admins.
BREAKGLASS_GROUPS="system:masters,sre-breakglass"
KAGENT_OIDC="false"                         # recommended: true (UI behind your IdP)
KAGENT_EXTERNAL_DB="false"                  # recommended: true (RDS/Aurora)
